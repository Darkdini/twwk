+let aiPendingEl=null;
+function aiFmt(t){
+  return escH(String(t||'')).replace(/\*\*(.+?)\*\*/g,'<b style="color:#e8d8ff;">$1</b>').replace(/\n/g,'<br>');
+}
+function aiBubble(role,html,steps){
+  const wrap=document.createElement('div');
+  const me=role==='user';
+  wrap.style.cssText=`display:flex;flex-direction:column;align-items:${me?'flex-end':'flex-start'};`;
+  const b=document.createElement('div');
+  b.style.cssText=`max-width:86%;padding:9px 12px;border-radius:12px;font-size:13px;line-height:1.45;`+
+    (me?'background:linear-gradient(180deg,#4a3a08,#2a2200);border:1px solid rgba(200,160,50,.6);color:#f0e0b0;border-bottom-right-radius:3px;'
+       :'background:linear-gradient(180deg,#1a1235,#100a22);border:1px solid rgba(120,90,220,.5);color:#d8d0f0;border-bottom-left-radius:3px;');
+  b.innerHTML=me?escH(html):html;
+  wrap.appendChild(b);
+  if(!me&&steps&&steps.length){
+    const d=document.createElement('details');
+    d.style.cssText='margin-top:3px;max-width:86%;';
+    d.innerHTML=`<summary style="cursor:pointer;font-size:10px;color:#8a7ad0;list-style:none;">💭 ход мыслей (${steps.length})</summary>`+
+      `<div style="font-size:10px;color:#9a8ad8;padding:4px 8px;border-left:2px solid rgba(120,90,220,.4);margin-top:3px;">`+
+      steps.map((s,i)=>`${i+1}. ${escH(s)}`).join('<br>')+`</div>`;
+    wrap.appendChild(d);
+  }
+  return wrap;
+}
+function aiAppend(role,html,steps){
+  const box=$('#ai-msgs');if(!box)return null;
+  const el=aiBubble(role,html,steps);
+  box.appendChild(el);box.scrollTop=box.scrollHeight;
+  return el;
+}
+function aiSend(text){
+  const inp=$('#ai-inp');
+  text=(text!=null?text:(inp?inp.value:'')||'').trim();
+  if(!text)return;
+  if(!ws||ws.readyState!==1){toast('Нет соединения с сервером','err');return;}
+  aiAppend('user',text);
+  if(inp){inp.value='';inp.focus();}
+  // плейсхолдер «думаю…»
+  aiPendingEl=aiAppend('assistant','<span style="opacity:.7;">🧠 думаю…</span>');
+  ws.send(JSON.stringify({type:'ai-chat',text}));
+}
+function aiReceive(msg){
+  if(!msg)return;
+  const html=aiFmt(msg.text);
+  if(aiPendingEl){
+    const fresh=aiBubble('assistant',html,msg.steps);
+    aiPendingEl.replaceWith(fresh);aiPendingEl=null;
+    const box=$('#ai-msgs');if(box)box.scrollTop=box.scrollHeight;
+  } else {
+    aiAppend('assistant',html,msg.steps);
+  }
+}
